{
  "name": "@rvagent/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kb": {
      "types": "./dist/kb/index.d.ts",
      "default": "./dist/kb/index.js"
    }
  },
  "files": ["dist", "prompts"],
  "scripts": {
    "compile-prompts": "node scripts/compile-prompts.mjs",
    "build": "node scripts/compile-prompts.mjs && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "eval": "tsx eval/run-eval.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@rvagent/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
