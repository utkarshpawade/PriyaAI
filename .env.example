# ---------------------------------------------------------------------------
# Real-estate voice agent — environment
#
# EVERY VALUE HERE IS OPTIONAL. With an empty file the project still runs:
# the browser transcribes with the Web Speech API, a deterministic rule-based
# LLM drives the conversation, and the browser speaks the reply. Add keys to
# upgrade individual stages; each one downgrades to a mock on its own.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml. If unset, both apps fall back to exactly this URL,
# so `pnpm db:up` is all you need locally.
# Production: a Neon connection string (https://neon.tech).
DATABASE_URL=postgresql://rvagent:rvagent@localhost:5433/rvagent?schema=public

# --- Provider selection ----------------------------------------------------
# Explicit choice wins; a provider whose key is missing downgrades to a mock and
# says so in the boot log and in the UI header.
#   STT_PROVIDER: deepgram | sarvam | browser | mock   (default: best available, else browser)
#   LLM_PROVIDER: gemini | openai | anthropic | mock   (default: best available, else mock)
#   TTS_PROVIDER: sarvam | elevenlabs | browser | mock (default: best available, else browser)
STT_PROVIDER=
LLM_PROVIDER=
TTS_PROVIDER=

# --- Speech to text --------------------------------------------------------
# Deepgram — streaming WebSocket STT. Use language=multi for Hinglish.
# Get a key: https://console.deepgram.com/  (free tier includes $200 credit)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Sarvam AI — best-in-class for Indian languages and code-switching.
# The same key serves both STT and TTS.
# Get a key: https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# --- Text to speech --------------------------------------------------------
# Sarvam Bulbul — natural Indian-accented Hindi/Hinglish. Uses SARVAM_API_KEY.
# Speaker options: anushka, manisha, vidya, arya, abhilash, karun, hitesh
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# ElevenLabs — multilingual, very low latency with eleven_flash_v2_5.
# Get a key: https://elevenlabs.io/app/settings/api-keys
# Voice IDs:  https://elevenlabs.io/app/voice-library  (both are required)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Language model --------------------------------------------------------
# Google Gemini — the default. Fast, cheap, strong on Hinglish.
# Get a key: https://aistudio.google.com/apikey  (generous free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — alternative.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — alternative.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Telephony (optional; the browser demo is the primary demo) -------------
# Twilio Programmable Voice + Media Streams.
# Get credentials: https://console.twilio.com/
# Indian numbers additionally need a regulatory bundle and DLT registration —
# see docs/LIMITATIONS.md before expecting outbound calls to work.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set false only when tunnelling locally (ngrok), where signatures never match.
TWILIO_VALIDATE_SIGNATURE=true

# --- Networking ------------------------------------------------------------
# Public https origin of the voice server. Required for Twilio webhooks so the
# TwiML can point at wss://<host>/twilio/stream.
PUBLIC_BASE_URL=

# Origins allowed to open the browser WebSocket. Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for the voice server's /internal/* endpoints. Leave empty
# locally; set it in production so only the web app can reload agent config.
INTERNAL_API_TOKEN=

# Voice server port and log level.
PORT=8787
LOG_LEVEL=info

# --- Web app ---------------------------------------------------------------
# Where the browser reaches the voice server. Point these at the deployed
# Render/Fly URL in production (wss:// and https://).
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8787
NEXT_PUBLIC_VOICE_HTTP_URL=http://localhost:8787
# Server-to-server URL (differs from the public one inside Docker).
VOICE_SERVER_URL=http://localhost:8787
